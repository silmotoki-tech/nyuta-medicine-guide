---
import { medicinesByExistingKanaRows, medicinesByReading, medicinePath, medicineSearchText } from '../data/medicines';

const kanaRows = medicinesByExistingKanaRows();
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>にゅうた動物病院 お薬情報</title>
  </head>
  <body>
    <main>
      <h1>にゅうた動物病院 お薬情報</h1>
      <p>処方されたお薬の名前から、作用・副反応・注意事項をご確認いただけます。</p>
      <label for="medicine-search">お薬の名前で探す</label>
      <input
        id="medicine-search"
        type="search"
        autocomplete="off"
        placeholder="薬剤名を入力"
      />
      <ul id="medicine-list">
        {medicinesByReading.map((medicine) => (
          <li data-search={medicineSearchText(medicine)}>
            <a href={medicinePath(medicine.slug)}>{medicine.displayName}</a>
          </li>
        ))}
      </ul>
      <p id="no-results" hidden>該当するお薬がありません</p>

      <section class="kana-section">
        <h2>50音順から探す</h2>
        {kanaRows.map((row) => (
          <div class="kana-row">
            <h3>{row.label}</h3>
            <ul>
              {row.medicines.map((medicine) => (
                <li>
                  <a href={medicinePath(medicine.slug)}>{medicine.displayName}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    overflow-x: hidden;
  }

  body {
    margin: 0;
    font-family: sans-serif;
    line-height: 1.6;
  }

  main {
    max-width: 40rem;
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 1rem 2rem;
  }

  h1 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    overflow-wrap: anywhere;
  }

  h2 {
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }

  h3 {
    font-size: 1.05rem;
    margin: 0 0 0.25rem;
  }

  p {
    margin: 0 0 1.5rem;
    font-size: 1rem;
  }

  label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }

  input[type="search"] {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 2.75rem;
    margin-bottom: 1rem;
    padding: 0.8rem 0.9rem;
    font-size: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-size: 1.15rem;
    border-bottom: 1px solid #ddd;
  }

  a {
    display: block;
    color: #0645ad;
    text-decoration: none;
    padding: 0.95rem 0;
    overflow-wrap: anywhere;
  }

  #no-results {
    margin-top: 1rem;
  }

  .kana-section {
    margin-top: 2.5rem;
  }

  .kana-row {
    margin-bottom: 1.25rem;
  }
</style>

<script is:inline>
  const searchInput = document.getElementById('medicine-search');
  const items = document.querySelectorAll('#medicine-list li');
  const noResults = document.getElementById('no-results');

  function toHiragana(text) {
    return text.replace(/[\u30A1-\u30F6]/g, (char) =>
      String.fromCharCode(char.charCodeAt(0) - 0x60)
    );
  }

  function filterMedicines() {
    const query = toHiragana(searchInput.value.trim());
    let visibleCount = 0;

    items.forEach((item) => {
      const haystack = toHiragana(item.getAttribute('data-search') || '');
      const isMatch = query === '' || haystack.includes(query);
      item.hidden = !isMatch;
      if (isMatch) {
        visibleCount += 1;
      }
    });

    noResults.hidden = visibleCount > 0;
  }

  searchInput.addEventListener('input', filterMedicines);
</script>
