---
import { medicines, medicinePath } from '../data/medicines';
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>にゅうた動物病院 お薬情報</title>
  </head>
  <body>
    <main>
      <h1>にゅうた動物病院 お薬情報</h1>
      <p>処方されたお薬の名前から、作用・副反応・注意事項をご確認いただけます。</p>
      <label for="medicine-search">お薬の名前で探す</label>
      <input
        id="medicine-search"
        type="search"
        autocomplete="off"
        placeholder="薬剤名を入力"
      />
      <ul id="medicine-list">
        {medicines.map((medicine) => (
          <li data-search={`${medicine.productName} ${medicine.genericName} ${medicine.listName}`}>
            <a href={medicinePath(medicine.slug)}>{medicine.listName}</a>
          </li>
        ))}
      </ul>
      <p id="no-results" hidden>該当するお薬がありません</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: sans-serif;
    line-height: 1.6;
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 2rem;
  }

  h1 {
    font-size: 1.6rem;
    margin: 0 0 1rem;
  }

  p {
    margin: 0 0 1.5rem;
    font-size: 1rem;
  }

  label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }

  input[type="search"] {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 1rem;
    padding: 0.7rem 0.8rem;
    font-size: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-size: 1.15rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid #ddd;
  }

  a {
    color: #0645ad;
    text-decoration: none;
  }

  #no-results {
    margin-top: 1rem;
  }
</style>

<script is:inline>
  const searchInput = document.getElementById('medicine-search');
  const items = document.querySelectorAll('#medicine-list li');
  const noResults = document.getElementById('no-results');

  function filterMedicines() {
    const query = searchInput.value.trim();
    let visibleCount = 0;

    items.forEach((item) => {
      const haystack = item.getAttribute('data-search') || '';
      const isMatch = query === '' || haystack.includes(query);
      item.hidden = !isMatch;
      if (isMatch) {
        visibleCount += 1;
      }
    });

    noResults.hidden = visibleCount > 0;
  }

  searchInput.addEventListener('input', filterMedicines);
</script>
